# Tavily API key (required for enrichment; pipeline runs without it, just skips enrichment)
# Get one at https://app.tavily.com — Pro plan enables the research models.
TAVILY_API_KEY=

# Optional overrides
# TAVILY_MODEL=mini            # mini (default, 4-110 credits/req) | pro (15-250)
# RECALL_RADAR_DATA_DIR=data
# RECALL_RADAR_MAX_ENRICH=10   # max recalls enriched per run (spend guard)
# RECALL_RADAR_MAX_ENRICH_ATTEMPTS=3
# RECALL_RADAR_ENRICH_INTERVAL=5

# MCP server transport: stdio (default) | streamable-http
# RECALL_RADAR_TRANSPORT=stdio
# RECALL_RADAR_HOST=0.0.0.0
# RECALL_RADAR_PORT=8000

# Hosted endpoint self-refresh (fetch latest recalls.json from a URL)
# RECALL_RADAR_DATA_URL=
# RECALL_RADAR_DATA_REFRESH_SECONDS=21600

# Rate limiting (hosted streamable-http transport only)
# RECALL_RADAR_RATE_LIMIT_REQUESTS=60   # per-IP requests allowed per window
# RECALL_RADAR_RATE_LIMIT_WINDOW=60      # window length in seconds
