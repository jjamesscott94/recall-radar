# Tavily API key (required for enrichment; pipeline runs without it, just skips enrichment)
# Get one at https://app.tavily.com — Pro plan enables the "pro" research model.
TAVILY_API_KEY=

# Optional overrides
# TAVILY_MODEL=pro
# RECALL_RADAR_DATA_DIR=data
# RECALL_RADAR_MAX_ENRICH=20

# MCP server transport: stdio (default) | streamable-http
# RECALL_RADAR_TRANSPORT=stdio
# RECALL_RADAR_HOST=0.0.0.0
# RECALL_RADAR_PORT=8000
